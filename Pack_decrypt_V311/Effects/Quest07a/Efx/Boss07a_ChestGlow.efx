      <ColorOperation>Modulate</ColorOperation>
      <UseDirectionAs>Normal</UseDirectionAs>
      <ProjectionNormal>
        <X>0</X>
        <Y>1</Y>
        <Z>0</Z>
      </ProjectionNormal>
      <ZBufferEnable>true</ZBufferEnable>
    </EffLayer>
  </EffLayers>
</Effect>