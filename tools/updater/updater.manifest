<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- ★ 这个 manifest 是硬要求：exe 的文件名里有 "Patcher"，Windows 的
       UAC「安装程序检测」启发式会对没有 manifest 的 exe 自动要求管理员
       权限 —— 客户端 CreateProcess 拉它必失败（ERROR_ELEVATION_REQUIRED，
       2026-08-22 真机定位），手动双击也直接弹 UAC。声明 asInvoker 后回到
       原版 NGM 的行为：不提权静默启动，要不要提权由我们自己问玩家。 -->
  <assemblyIdentity version="2.0.0.0" processorArchitecture="*"
                    name="PopShot.Reborn.Updater" type="win32"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Win10/11（不声明则按老系统兼容行为） -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
