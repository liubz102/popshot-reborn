// 版本资源：UAC 提权确认框和任务管理器里显示的名字靠它。
// 没有这个，UAC 框只会显示干巴巴的 "BsPatcherChn.exe"。
// ★ 用 UTF-8 + code_page(65001)：rc.exe 默认按系统代码页读源文件，
//   中文字符串会乱码；pragma 在前就能按 UTF-8 读。
#pragma code_page(65001)

#include <windows.h>

#define VER_FILEVERSION         2,0,0,0
#define VER_FILEVERSION_STR     "2.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文；04b0 = Unicode
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "炮炮火枪手 自动更新"
            VALUE "ProductName",     "炮炮火枪手 复活版"
            VALUE "FileVersion",     VER_FILEVERSION_STR
            VALUE "ProductVersion",  VER_FILEVERSION_STR
            VALUE "OriginalFilename", "BsPatcherChn.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
