# ============================================================================
#  炮炮火枪手 —— 服务端配置
#
#  这份是【服务端包】的配置，能改的就下面这几样：注册页端口、注册冷却时间、
#  日志保留天数、数据自动备份、以及收玩家崩溃包的上限 / 冷却 / 保留天数。
#  认证服（47611）和游戏服（27799）的端口是客户端写死的，不需要也不能配置；
#  战斗同步中继固定 27798；监听地址固定 ::（IPv4 / IPv6 都能连进来）。
# ============================================================================

# ---------------------------------------------------------------------------
# 「用户注册页」监听的端口号。
# 玩家在浏览器里打开 http://<这台机器的地址>:这个端口/ 注册账号。
#
# ★ 改了这里，玩家那边【客户端包】的 server.config 里
#   server_register_port 也要改成一样的值，否则游戏里那个注册链接会点开
#   一个打不开的地址。
#
# 端口被别的程序占用时改这里。
# ---------------------------------------------------------------------------
local_register_port = 27810

# ---------------------------------------------------------------------------
# 注册冷却时间（秒）—— 防止有人拿脚本批量注册。
#
# 一次注册【成功】之后：
#   * 注册页上的「注册」按钮会锁住并倒计时这么多秒（玩家刷新页面也一样锁着）；
#   * 服务器也会记住那个 IP，这段时间里它再来注册一律拒绝。
# 两边用的是同一个数字，改这里就都改了。
#
# 注册【失败】（用户名重复、昵称重复、两次密码不一致等）不算，
# 按钮会立刻恢复可点。
# 填 0 = 完全不限制。
#
# ★ 注意：IP 记录【只放在内存里】，服务端一重启就清空 —— 这是有意的，
#   免得多一个只增不减、没人清理的文件。
# ★ 注意：几个人共用一条宽带出口（同一个公网 IP）时，他们会互相排队，
#   一起开号的话把这个值调小一点。
# ---------------------------------------------------------------------------
register_cooldown_seconds = 20

# ---------------------------------------------------------------------------
# 日志自动清理 —— logs/ 目录里超过这么多天没再写过的日志文件会被删掉。
#
# 清理时机有两个：
#   * 服务端【每次真正启动】时一次；已经在跑而跳过启动时，清理也跟着跳过。
#   * 每天【凌晨 4 点】一次（云服务器常年开机，等不到下一次启动）。
# 两次都在后台线程里做，不会影响正在进行的对局。
#
# 清的是 logs/ 里的日志文件（*.log / *.out / *.err / game_* / auth_* / conn_*），
# 判据是文件最后修改时间；正在写的日志因此不会被删。
# 填 0 = 不清理。
# ---------------------------------------------------------------------------
log_retention_days = 3

# ---------------------------------------------------------------------------
# 数据自动备份（管理页 /admin 的「数据备份」标签页，只有系统管理员看得到）
#
# 每天到 backup_time（服务器本地时间）把 server/data/ 下的全部 json —— 账号存档
# accounts.json 和 物品库 / 商店货架 / 合成配方 / 材料掉落 —— 原样拷一份到
# server/data/backups/<时刻-类型>/，早于 backup_keep_days 天的备份自动删掉
# （手动备份、回滚前的自动备份也算在内；填 0 = 永不自动删除）。
# 服务端在那个时刻没开着，那天就没有自动备份（不补做）。
#
# ⚠ 备份里的 accounts.json 含明文密码，和它本体一样敏感，别随包分发。
# ★ 在管理页里改这三项会立刻生效并写回这里；直接改这个文件的话，
#   要打开一次「数据备份」标签页（或等到备份时刻）才会被读到。
# ---------------------------------------------------------------------------
backup_enabled = 1
backup_time = 04:00
backup_keep_days = 7

# ---------------------------------------------------------------------------
# 客户端崩溃日志接收
#
# 玩家在登录界面选了「远程服务器」、游戏中途闪退时，客户端会把这一次的崩溃现场
# （崩溃报告 + 内存转储 + 当天日志，压缩后通常 10 MB 上下）自动传上来，
# 收在包根的 logs_client_crash/ 下 —— 每收到一份新建一个子目录，目录名是
# 「账号名_安装码_崩溃时刻」，这样按名称排序时同一个玩家的历次崩溃会挨在一起。
# 收到的压缩包不自动解压。
#
#   crash_max_upload_mb           —— 单个崩溃包的大小上限（MB）。超过直接拒收。
#                                    填 0 = 不接收任何崩溃上传。
#   crash_upload_cooldown_seconds —— 同一个 IP 两次上传之间至少隔多少秒。
#                                    填 0 = 不限制。记录只在内存里，重启就清空。
#   crash_keep_days               —— 崩溃包保留多少天，过期自动删。
#                                    清理时机和上面的日志清理一样（启动时一次 +
#                                    每天凌晨 4 点一次）。填 0 = 永不自动删除。
#
# ★ 崩溃包走注册页那个端口（POST /api/crash-report），防火墙不用多放行一个口。
# ⚠ 内存转储是玩家游戏进程当时的内存快照，理论上可能含有他刚输入的东西
#   （包括密码）。收上来的东西和 accounts.json 一样敏感，别随手转发。
# ---------------------------------------------------------------------------
crash_max_upload_mb = 64
crash_upload_cooldown_seconds = 20
crash_keep_days = 3

# ---------------------------------------------------------------------------
# 说明：
#   * server_address / server_register_port / crash_upload 这三个键是
#     【客户端包】用的（前两个让客户端知道要连哪台服务器，crash_upload 是
#     玩家自己决定崩了要不要上传），服务端这边不用填。
#   * 账号和密码在本项目里是【明文】保存（server/data/accounts.json）和传输的。
#     请告诉玩家：不要使用在其他网站用过的密码。
#   * 账号数据就是 server/data/accounts.json 一个文件；管理页「数据备份」
#     每天会连同四份运营配置一起备份到 server/data/backups/，要搬家就整个
#     server/data/ 目录拷走。
# ---------------------------------------------------------------------------
